# PASS: Single-file optimization demo (Constant Folding + Dead Code Pruning).
# Best used with ParserDriver to show semantic optimization log.

gamitin magpakita

konstant a = 2 + 3 * 4
konstant b = (10 - 1) * 2
konstant c = a + b

magpakita c

kung mali:
    magpakita unknown_name + 1
tapos
kundi:
    magpakita "reachable branch"
tapos

kung totoo:
    magpakita "always true branch"
tapos
kundi:
    magpakita not_declared_var
tapos
